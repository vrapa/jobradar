APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Prague
# APP_RUNTIME_DIR=/writable/path

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=jobradar
DB_USER=jobradar
DB_PASSWORD=change-me-before-production
DB_ROOT_PASSWORD=change-root-before-production

# Runner čte token pouze z prostředí; nevkládejte skutečný token do verzovaného souboru.
# JOBRADAR_RUNNER_API_URL=http://localhost:8080/api/v1
# JOBRADAR_RUNNER_TOKEN=jr_replace_with_one_time_issued_token

# MCP server používá vlastní odvolatelný token; nikdy jej necommitujte.
# JOBRADAR_MCP_API_URL=http://localhost:8080/api/v1
# JOBRADAR_MCP_TOKEN=jr_replace_with_one_time_issued_token
