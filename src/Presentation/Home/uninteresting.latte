{block title}Nezajímavé nabídky{/block}

{block content}
<header class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Archiv rozhodnutí</p>
    <h1 class="display-6 fw-bold">Nezajímavé nabídky</h1>
    <p class="lead text-body-secondary">Tyto nabídky jsou skryté z přehledu. Vrácením mezi nerozhodnuté je znovu zobrazíte.</p>
    <a n:href="Home:" class="btn btn-outline-primary">Zpět na přehled</a>
</header>

<div n:if="$opportunityCount === 0" class="card shadow-sm"><div class="card-body py-5 text-center">
    <h2 class="h4">Žádné skryté nabídky</h2>
</div></div>

<div n:if="$opportunityCount > 0" class="list-group shadow-sm">
    <div n:foreach="$opportunities as $opportunity" class="list-group-item py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h6 mb-1"><a n:href="Opportunity:detail $opportunity->id">{$opportunity->title}</a></h2>
                <p class="text-body-secondary mb-0">{$opportunity->companyName ?? 'Společnost neuvedena'}</p>
            </div>
            {form "quickDecision-$opportunity->id"}
                <div n:foreach="$form->errors as $error" class="alert alert-warning py-2 small">{$error}</div>
                <button n:name="undo" class="btn btn-sm btn-outline-primary">Vrátit mezi nerozhodnuté</button>
            {/form}
        </div>
    </div>
</div>
{/block}
