{block title}Přehled{/block}

{block content}
<header class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Soukromý pracovní radar</p>
    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-between align-items-sm-center">
        <div>
            <h1 class="display-6 fw-bold mb-1">Nabídky</h1>
            <p class="lead text-body-secondary mb-0">Originál, překlad a historie na jednom místě.</p>
        </div>
        <a n:href="OpportunityImport:" class="btn btn-primary">Přidat nabídku</a>
    </div>
</header>

<section class="card shadow-sm mb-4 {if $coverage !== null && ($coverage->loginRequiredCount > 0 || $coverage->errorCount > 0)}border-warning-subtle{/if}" aria-labelledby="coverage-title">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 id="coverage-title" class="h5 mb-1">Poslední kontrola zdrojů</h2>
                <p n:if="$coverage === null" class="text-body-secondary mb-0">Zatím nebyla výslovně vyžádána žádná kontrola.</p>
                <p n:if="$coverage !== null" class="mb-0">
                    <strong>{$coverage->completeCount} z {$coverage->plannedCount}</strong> zdrojů úplně zkontrolováno
                    {if $coverage->loginRequiredCount > 0}, {$coverage->loginRequiredCount} vyžaduje přihlášení{/if}
                    {if $coverage->errorCount > 0}, {$coverage->errorCount} skončilo chybou{/if}.
                </p>
            </div>
            <a n:if="$coverage !== null" n:href="SearchRequest:detail $coverage->requestId" class="btn btn-outline-primary">Detail kontroly</a>
            <a n:if="$coverage === null" n:href="Source:" class="btn btn-outline-primary">Spustit kontrolu</a>
        </div>
    </div>
</section>

<div class="d-flex gap-2 align-items-center mb-3">
    <span class="badge text-bg-primary rounded-pill">{$opportunityCount}</span>
    <span class="text-body-secondary">uložených nabídek</span>
</div>

<div n:if="$opportunityCount === 0" class="card shadow-sm">
    <div class="card-body py-5 text-center">
        <h2 class="h4">Zatím tu nic není</h2>
        <p class="text-body-secondary">Začněte ručním importem první nabídky.</p>
        <a n:href="OpportunityImport:" class="btn btn-primary">Importovat nabídku</a>
    </div>
</div>

<div n:if="$opportunityCount > 0" class="row g-3">
    <div n:foreach="$opportunities as $opportunity" class="col-12 col-lg-6">
        <article class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex gap-2 mb-2">
                    <span class="badge text-bg-light border">{$opportunity->validityStatus === 'unknown' ? 'Platnost neověřena' : $opportunity->validityStatus}</span>
                    <span n:if="$opportunity->incomplete" class="badge text-bg-warning">Neúplné</span>
                    <span n:if="$opportunity->decision->value === 'react'" class="badge text-bg-success">K reakci</span>
                </div>
                <h2 class="h5"><a n:href="Opportunity:detail $opportunity->id" class="stretched-link text-decoration-none">{$opportunity->title}</a></h2>
                <p class="text-body-secondary mb-3">{$opportunity->companyName ?? 'Společnost neuvedena'}</p>
                <p n:if="$opportunity->summary !== null" class="small mb-3">{$opportunity->summary}</p>
                <dl class="row g-2 small mb-3">
                    <div class="col-12 col-sm-4">
                        <dt class="text-body-secondary fw-normal">Sazba</dt>
                        <dd class="fw-semibold mb-0">
                            {if $opportunity->rateMin !== null || $opportunity->rateMax !== null}
                                {$opportunity->rateMin ?? '?'}–{$opportunity->rateMax ?? '?'} {$opportunity->currency ?? ''}{if $opportunity->rateUnit !== null}/{$opportunity->rateUnit}{/if}
                            {else}Neznámá{/if}
                        </dd>
                    </div>
                    <div class="col-12 col-sm-4">
                        <dt class="text-body-secondary fw-normal">Rozsah</dt>
                        <dd class="fw-semibold mb-0">
                            {if $opportunity->workloadMin !== null || $opportunity->workloadMax !== null}
                                {$opportunity->workloadMin ?? '?'}–{$opportunity->workloadMax ?? '?'} {$opportunity->workloadUnit ?? ''}
                            {else}Neznámý{/if}
                        </dd>
                    </div>
                    <div class="col-12 col-sm-4">
                        <dt class="text-body-secondary fw-normal">Skóre</dt>
                        <dd class="fw-semibold mb-0">
                            {if $opportunity->scoreMin !== null && $opportunity->scoreMax !== null}
                                {$opportunity->scoreMin}–{$opportunity->scoreMax}
                            {else}Nevypočteno{/if}
                            <span n:if="$opportunity->coveragePercent !== null" class="d-block fw-normal text-body-secondary">pokrytí {$opportunity->coveragePercent} %</span>
                        </dd>
                    </div>
                </dl>
                {form "quickDecision-$opportunity->id", class: 'position-relative z-2 border-top pt-3 mt-2'}
                    <div n:foreach="$form->errors as $error" class="alert alert-warning py-2 small">{$error}</div>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <select n:name="reason" class="form-select form-select-sm" aria-label="Důvod nezájmu"></select>
                        <div class="btn-group btn-group-sm flex-shrink-0" role="group" aria-label="Rychlé rozhodnutí">
                            <button n:if="$opportunity->decision->value !== 'react'" n:name="react" class="btn btn-outline-success">Reagovat</button>
                            <button n:if="$opportunity->decision->value !== 'uninteresting'" n:name="uninteresting" class="btn btn-outline-secondary">Nezajímavé</button>
                            <button n:if="$opportunity->decision->value !== 'undecided'" n:name="undo" class="btn btn-outline-primary">Zpět</button>
                        </div>
                    </div>
                {/form}
                <p class="small text-body-secondary mt-auto mb-0">Nalezeno {$opportunity->foundAt|date:'j. n. Y H:i'}</p>
            </div>
        </article>
    </div>
</div>
{/block}
