{block title}{$opportunity->title}{/block}

{block content}
<nav aria-label="Drobečková navigace" class="mb-3">
    <a n:href="Home:" class="text-decoration-none">Nabídky</a>
    <span class="text-body-secondary mx-2" aria-hidden="true">/</span>
    <span aria-current="page">Detail</span>
</nav>

<header class="mb-4">
    <div class="d-flex flex-wrap gap-2 mb-2">
        <span class="badge text-bg-light border">{$opportunity->validityStatus === 'unknown' ? 'Platnost neověřena' : $opportunity->validityStatus}</span>
        <span n:if="$opportunity->incomplete" class="badge text-bg-warning">Neúplný zdroj</span>
        <span class="badge text-bg-light border">{$opportunity->versionCount} {if $opportunity->versionCount === 1}verze{else}verzí{/if}</span>
    </div>
    <h1 class="display-6 fw-bold mb-2">{$opportunity->title}</h1>
    <p class="lead text-body-secondary">{$opportunity->companyName ?? 'Společnost neuvedena'}</p>
    <div class="d-flex flex-wrap gap-2">
        <a href="{$opportunity->canonicalUrl}" class="btn btn-outline-primary" rel="noopener noreferrer" target="_blank">Otevřít původní stránku</a>
        <a n:href="OpportunityTerms: $opportunity->id" class="btn btn-primary">Upravit podmínky</a>
    </div>
</header>

<section class="card shadow-sm mb-4 border-primary-subtle" aria-labelledby="decision-title">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="decision-title" class="h5 mb-0">Moje rozhodnutí</h2>
            <span class="badge {if $opportunity->decisionState->decision->value === 'react'}text-bg-success{elseif $opportunity->decisionState->decision->value === 'uninteresting'}text-bg-secondary{else}text-bg-light border{/if}">
                {if $opportunity->decisionState->decision->value === 'react'}K reakci{elseif $opportunity->decisionState->decision->value === 'uninteresting'}Nezajímavé{else}Nerozhodnuto{/if}
            </span>
        </div>
        <p class="small text-body-secondary">„Reagovat“ nabídku pouze zařadí do interní fronty. Nic neodešle a nepředá žádné osobní údaje.</p>
        {form decisionForm}
            <div n:if="$form->hasErrors()" class="alert alert-danger" role="alert"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label n:name="reason" class="form-label">Důvod pro „Nezajímavé“</label>
                    <select n:name="reason" class="form-select"></select>
                </div>
                <div class="col-12 col-lg-8">
                    <label n:name="note" class="form-label">Soukromá poznámka <span class="text-body-secondary">(volitelné)</span></label>
                    <textarea n:name="note" class="form-control"></textarea>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button n:name="react" class="btn btn-success">Reagovat</button>
                    <button n:name="uninteresting" class="btn btn-outline-secondary">Nezajímavé</button>
                    <button n:if="$opportunity->decisionState->decision->value !== 'undecided'" n:name="undo" class="btn btn-link">Zpět na nerozhodnuto</button>
                </div>
            </div>
        {/form}
    </div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="h5 mb-0">Podmínky</h2>
            <a n:href="OpportunityTerms: $opportunity->id" class="small">Upravit</a>
        </div>
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="small text-body-secondary">Sazba</div>
                <div class="fw-semibold">
                    {if $opportunity->terms?->rateMin !== null || $opportunity->terms?->rateMax !== null}
                        {$opportunity->terms?->rateMin ?? '?'}–{$opportunity->terms?->rateMax ?? '?'} {$opportunity->terms?->currency ?? ''}{if $opportunity->terms?->rateUnit !== null}/{$opportunity->terms->rateUnit}{/if}
                    {else}Neznámá{/if}
                </div>
                <div n:if="$opportunity->terms?->rateSource !== null" class="small text-body-secondary">{$opportunity->terms->rateSource}, jistota {$opportunity->terms->rateConfidence}</div>
            </div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Režim</div><div class="fw-semibold">{$opportunity->terms?->remoteMode ?? 'Neznámý'}</div></div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Práce z ČR</div><div class="fw-semibold">{if $opportunity->terms?->workFromCzechia === true}Ano{elseif $opportunity->terms?->workFromCzechia === false}Ne{else}Neověřeno{/if}</div></div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Rozsah</div><div class="fw-semibold">{if $opportunity->terms?->workloadMin !== null || $opportunity->terms?->workloadMax !== null}{$opportunity->terms?->workloadMin ?? '?'}–{$opportunity->terms?->workloadMax ?? '?'} {$opportunity->terms?->workloadUnit ?? ''}{else}Neznámý{/if}</div></div>
            <div n:if="$opportunity->terms?->location !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Lokalita</div><div>{$opportunity->terms->location}</div></div>
            <div n:if="$opportunity->terms?->workingLanguage !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Jazyk</div><div>{$opportunity->terms->workingLanguage}</div></div>
            <div n:if="$opportunity->terms?->communicationMode !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Komunikace</div><div>{$opportunity->terms->communicationMode}</div></div>
            <div n:if="$opportunity->terms?->durationText !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Délka</div><div>{$opportunity->terms->durationText}</div></div>
        </div>
        <div n:if="count($opportunity->technologies) > 0" class="mt-3 d-flex flex-wrap gap-2">
            <span n:foreach="$opportunity->technologies as $technology" class="badge {$technology->requirementLevel === 'required' ? 'text-bg-primary' : ($technology->requirementLevel === 'advantage' ? 'text-bg-info' : 'text-bg-light border')}">{$technology->name}{if $technology->requirementLevel === 'required'} · povinné{elseif $technology->requirementLevel === 'advantage'} · výhodou{/if}</span>
        </div>
    </div>
</section>

<section n:if="$opportunity->summary !== null" class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Shrnutí</h2>
        <p class="mb-0 preserve-lines">{$opportunity->summary}</p>
    </div>
</section>

<div class="row g-4">
    <div n:if="$opportunity->translatedText !== null" class="col-12 col-xl-6">
        <section class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Český překlad</h2>
                <p n:if="$opportunity->translatedTitle !== null" class="fw-semibold">{$opportunity->translatedTitle}</p>
                <div class="offer-text">{$opportunity->translatedText}</div>
            </div>
        </section>
    </div>
    <div class="col-12 {$opportunity->translatedText !== null ? 'col-xl-6' : ''}">
        <section class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Originál</h2>
                <p class="fw-semibold">{$opportunity->originalTitle}</p>
                <div class="offer-text">{$opportunity->originalText}</div>
            </div>
        </section>
    </div>
</div>

<p class="small text-body-secondary mt-4 mb-0">
    Nalezeno {$opportunity->foundAt|date:'j. n. Y H:i'}, aktuální verze získána {$opportunity->acquiredAt|date:'j. n. Y H:i'}{if $opportunity->sourceLanguage !== null}, jazyk {$opportunity->sourceLanguage}{/if}.
</p>

<section n:if="$opportunity->versionCount > 1" class="mt-5" aria-labelledby="version-history-title">
    <h2 id="version-history-title" class="h4 mb-3">Historie verzí</h2>
    <div class="vstack gap-2">
        <details n:foreach="$opportunity->versions as $version" class="card shadow-sm" n:attr="open => $version->current">
            <summary class="card-header version-summary">
                <span class="fw-semibold">{$version->acquiredAt|date:'j. n. Y H:i'}</span>
                <span n:if="$version->current" class="badge text-bg-primary ms-2">Aktuální</span>
                <span n:if="$version->incomplete" class="badge text-bg-warning ms-2">Neúplná</span>
            </summary>
            <div class="card-body">
                <h3 class="h6">{$version->translatedTitle ?? $version->originalTitle}</h3>
                <div n:if="$version->translatedText !== null" class="offer-text mb-4">{$version->translatedText}</div>
                <h4 n:if="$version->translatedText !== null" class="h6 text-body-secondary">Originál</h4>
                <div class="offer-text">{$version->originalText}</div>
            </div>
        </details>
    </div>
</section>
{/block}
