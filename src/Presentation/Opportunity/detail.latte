{block title}{$opportunity->title}{/block}

{block content}
<details class="card p-3 mb-3" n:attr="open: $presenter['counterpartyForm']->hasErrors()">
    <summary>Protistrana: {App\Opportunity\CounterpartyInput::LABELS[$opportunity->counterpartyHistory[0]['value'] ?? ''] ?? 'neověřeno'}</summary>
    {form counterpartyForm}
    <div n:if="$form->hasErrors()" class="alert alert-danger mt-3" role="alert"><ul><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
    <div class="my-3">{label counterpartyValue /}{input counterpartyValue, class: 'form-select'}</div>
    <div class="mb-3">{label counterpartyReason /}{input counterpartyReason, class: 'form-control'}</div>
    <div class="mb-3">{label counterpartyConfidence /}{input counterpartyConfidence, class: 'form-control'}</div>
    <button n:name="send" class="btn btn-primary mb-3">Uložit protistranu</button>
    {/form}
    <ul><li n:foreach="$opportunity->counterpartyHistory as $c">{App\Opportunity\CounterpartyInput::LABELS[$c['value'] ?? ''] ?? 'neověřeno'} · {$c['reason']} · jistota {$c['confidence'] ?? 'neověřeno'} · ověřeno {$c['verified_at'] ?? 'neověřeno'} · verze nabídky #{$c['source_version_id']}</li></ul>
</details>
<details class="card p-3 mb-3" n:attr="open: $presenter['projectCareForm']->hasErrors()">
    <summary>Převzetí / péče o existující aplikaci: {if count($opportunity->projectCareHistory) === 0 || $opportunity->projectCareHistory[0]['value'] === null}neověřeno{else}{$opportunity->projectCareHistory[0]['value'] ? 'ano' : 'ne'}{/if}</summary>
    {form projectCareForm}
        <div n:if="$form->hasErrors()" class="alert alert-danger mt-3" role="alert"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
        <div class="my-3"><label n:name="projectCareValue" class="form-label">Převzetí / péče o existující aplikaci</label><select n:name="projectCareValue" class="form-select"></select></div>
        <div class="mb-3"><label n:name="projectCareReason" class="form-label">Zdůvodnění klasifikace</label><textarea n:name="projectCareReason" class="form-control"></textarea></div>
        <div class="mb-3"><label n:name="projectCareConfidence" class="form-label">Jistota 0–1</label><input n:name="projectCareConfidence" class="form-control"></div>
        <button n:name="send" class="btn btn-primary mb-3">Uložit klasifikaci</button>
    {/form}
    <ul><li n:foreach="$opportunity->projectCareHistory as $c">{$c['created_at']} · verze nabídky #{$c['source_version_id']} · {$c['value'] === null ? 'neověřeno' : ($c['value'] ? 'ano' : 'ne')} · {$c['reason']} · jistota {$c['confidence'] ?? 'neznámá'} · ověřeno {$c['verified_at'] ?? 'neověřeno'}</li></ul>
</details>
<div n:if="count($opportunity->discoveries) > 0" class="card p-3 mb-3"><h2 class="h6">Cesta nalezení</h2><p n:foreach="$opportunity->discoveries as $d">{$d['source_name']} · {$d['query_text']} · {$d['discovered_at']}</p></div>
<nav aria-label="Drobečková navigace" class="mb-3">
    <a n:href="Home:" class="text-decoration-none">Nabídky</a>
    <span class="text-body-secondary mx-2" aria-hidden="true">/</span>
    <span aria-current="page">Detail</span>
</nav>

<header class="mb-4">
    <div class="d-flex flex-wrap gap-2 mb-2">
        <span class="badge text-bg-light border">{$opportunity->validityStatus === 'unknown' ? 'Platnost neověřena' : $opportunity->validityStatus}</span>
        <span n:if="$opportunity->incomplete" class="badge text-bg-warning">Neúplný obsah nabídky</span>
        <span class="badge text-bg-light border">{$opportunity->versionCount} {if $opportunity->versionCount === 1}verze{else}verzí{/if}</span>
    </div>
    <h1 class="display-6 fw-bold mb-2">{$opportunity->title}</h1>
    <p class="lead text-body-secondary">{$opportunity->companyName ?? 'Společnost neuvedena'}</p>
    <div class="d-flex flex-wrap gap-2">
        <a href="{$opportunity->canonicalUrl}" class="btn btn-outline-primary" rel="noopener noreferrer" target="_blank">Otevřít původní stránku</a>
        <a n:href="OpportunityTerms: $opportunity->id" class="btn btn-primary">Upravit podmínky</a>
    </div>
</header>

<section n:if="count($attachmentReviews) > 0" class="card p-3 mb-4">
    <h2 class="h5">Přílohy a podklady</h2>
    <p class="text-body-secondary">Ověření řešíme v projektu Práce. Dokončení navazujícího úkolu samo nepotvrzuje přečtení přílohy.</p>
    <article n:foreach="$attachmentReviews as $attachment" class="border-top pt-3 mb-3">
        <h3 class="h6">{$attachment['name']}</h3>
        <span class="badge {$attachment['status'] === 'pending' ? 'text-bg-warning' : 'text-bg-light border'}">{$attachment['status'] === 'pending' ? 'Čeká na ověření přílohy' : ($attachment['status'] === 'reviewed' ? 'Příloha prověřena' : 'Příloha není potřebná')}</span>
        <p class="preserve-lines mt-2">{$attachment['reason']}</p>
        <p n:if="$attachment['questions'] !== ''" class="preserve-lines"><strong>Co zjistit:</strong> {$attachment['questions']}</p>
        <p n:if="$attachment['findings'] !== ''" class="preserve-lines"><strong>Zjištění:</strong> {$attachment['findings']}</p>
        <p n:if="$attachment['evidence'] !== ''" class="preserve-lines"><strong>Doklad:</strong> {$attachment['evidence']}</p>
        <p class="small text-body-secondary">Pozorováno {$attachment['observed_at']}</p>
    </article>
    <details open><summary>Zapsat výsledek ověření</summary>
    {form attachmentForm}
        <div n:if="$form->hasErrors()" class="alert alert-danger"><p n:foreach="$form->errors as $error">{$error}</p></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6">{label key, class: 'form-label' /}{input key, class: 'form-select'}</div>
            <div class="col-12">{label status, class: 'form-label' /}{input status, class: 'form-select'}</div>
            <div class="col-12">{label reason, class: 'form-label' /}{input reason, class: 'form-control'}</div>
            <div class="col-12">{label findings, class: 'form-label' /}{input findings, class: 'form-control'}</div>
            <div class="col-12">{label evidence, class: 'form-label' /}{input evidence, class: 'form-control'}</div>
            <div class="col-12">{input save, class: 'btn btn-primary'}</div>
        </div>
    {/form}
    </details>
</section>

<section class="card shadow-sm mb-4 {if $assessment !== null}border-info-subtle{/if}" aria-labelledby="assessment-title">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="assessment-title" class="h5 mb-0">Posouzení a doporučení</h2>
            <span n:if="$assessment !== null" class="badge {if $assessment->recommendation->value === 'react'}text-bg-success{elseif $assessment->recommendation->value === 'uninteresting'}text-bg-secondary{else}text-bg-warning{/if}">
                {if $assessment->recommendation->value === 'react'}Doporučení: reagovat{elseif $assessment->recommendation->value === 'uninteresting'}Doporučení: nezajímavé{else}Doporučení: ověřit{/if}
            </span>
        </div>
        <div n:if="$assessment === null" class="text-body-secondary">Nabídka zatím nemá uložené posouzení.</div>
        <div n:if="$assessment !== null">
            <p class="preserve-lines">{$assessment->summary}</p>
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3"><div class="small text-body-secondary">Pokrytí</div><div class="fw-semibold">{$assessment->coverage * 100|number:0} %</div></div>
                <div class="col-6 col-md-3"><div class="small text-body-secondary">Jistota</div><div class="fw-semibold">{$assessment->confidence * 100|number:0} %</div></div>
                <div class="col-6 col-md-3"><div class="small text-body-secondary">Skóre</div><div class="fw-semibold">{if $assessment->scoreMin !== null}{$assessment->scoreMin}–{$assessment->scoreMax}{else}Bez schváleného skóre{/if}</div></div>
                <div class="col-6 col-md-3"><div class="small text-body-secondary">Pravidla</div><div class="fw-semibold">{$assessment->ruleSetName} v{$assessment->ruleSetVersion}</div><span n:if="$assessment->ruleSetStatus === 'draft'" class="badge text-bg-light border">návrh</span></div>
            </div>
            <div n:if="count($assessment->findings) > 0" class="vstack gap-2 mb-3">
                <div n:foreach="$assessment->findings as $finding" class="p-3 rounded border">
                    <span class="badge {if $finding->type === 'blocker'}text-bg-danger{elseif $finding->type === 'strong_match'}text-bg-success{elseif $finding->type === 'question'}text-bg-warning{else}text-bg-light border{/if}">
                        {if $finding->type === 'strong_match'}Silná shoda{elseif $finding->type === 'acceptable_gap'}Přijatelná mezera{elseif $finding->type === 'blocker'}Překážka{else}Otázka{/if}
                    </span>
                    <span class="small text-body-secondary ms-1">{$finding->severity}</span>
                    <div class="mt-2 preserve-lines">{$finding->text}</div>
                    <div n:if="$finding->evidenceReference !== null" class="small text-body-secondary mt-1">Podklad: {$finding->evidenceReference}</div>
                </div>
            </div>
            <details n:if="count($assessment->breakdowns) > 0">
                <summary class="fw-semibold version-summary">Rozklad posouzení</summary>
                <div class="vstack gap-2 mt-2">
                    <div n:foreach="$assessment->breakdowns as $breakdown" class="p-3 bg-body-tertiary rounded">
                        <h3 class="h6">{$breakdown->area}{if $breakdown->scoreMin !== null} · {$breakdown->scoreMin}–{$breakdown->scoreMax} bodů{/if}</h3>
                        <p class="mb-1 preserve-lines">{$breakdown->explanation}</p>
                        <p n:if="$breakdown->evidence !== null" class="small text-body-secondary mb-0 preserve-lines">Podklad: {$breakdown->evidence}</p>
                    </div>
                </div>
            </details>
            <p class="small text-body-secondary mt-3 mb-0">Profil {$assessment->profileName} v{$assessment->profileVersion}; vytvořeno {$assessment->createdAt|date:'j. n. Y H:i'}{if $assessment->modelIdentifier !== null}; model {$assessment->modelIdentifier}{/if}.</p>
        </div>
    </div>
</section>

<section class="card shadow-sm mb-4" aria-labelledby="action-items-title">
    <div class="card-body">
        <h2 id="action-items-title" class="h5">Navazující úkoly</h2>
        <p class="small text-body-secondary">Sem patří jen konkrétní krok nebo termín. Nabídka, rozhodnutí a stav žádosti zůstávají v JobRadaru; Todoist je pouze externí připomínka.</p>
        <div n:if="count($actionItems) === 0" class="text-body-secondary mb-3">Zatím není evidován žádný navazující úkol.</div>
        <ul n:if="count($actionItems) > 0" class="list-group mb-3">
            <li n:foreach="$actionItems as $item" class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <strong>{$item['title']}</strong>
                    <span class="badge {$item['status'] === 'open' ? 'text-bg-primary' : ($item['status'] === 'completed' ? 'text-bg-success' : 'text-bg-secondary')}">{$item['status'] === 'open' ? 'Otevřeno' : ($item['status'] === 'completed' ? 'Hotovo' : 'Zrušeno')}</span>
                </div>
                <div class="small text-body-secondary">{App\Action\ActionItemService::TYPES[$item['action_type']]}{if $item['due_at'] !== null} · termín {$item['due_at']|date:'j. n. Y H:i'}{/if}</div>
                <div n:if="$item['details'] !== null" class="preserve-lines mt-2">{$item['details']}</div>
                <a n:if="$item['external_url'] !== null" href="{$item['external_url']}" rel="noopener noreferrer" target="_blank" class="small">Otevřít úkol v Todoistu</a>
                <span n:if="$item['external_id'] !== null && $item['external_url'] === null" class="small text-body-secondary">Propojeno s Todoistem</span>
            </li>
        </ul>
        <details class="mb-3" open>
            <summary class="fw-semibold">Přidat konkrétní krok</summary>
            {form actionItemForm, class: 'mt-3'}
                <div n:if="$form->hasErrors()" class="alert alert-danger"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
                <div class="row g-3">
                    <div class="col-12 col-md-4"><label n:name="type" class="form-label">Typ kroku</label><select n:name="type" class="form-select"></select></div>
                    <div class="col-12 col-md-8"><label n:name="title" class="form-label">Konkrétní další krok</label><input n:name="title" class="form-control"></div>
                    <div class="col-12 col-md-8"><label n:name="details" class="form-label">Podrobnosti</label><textarea n:name="details" class="form-control"></textarea></div>
                    <div class="col-12 col-md-4"><label n:name="dueAt" class="form-label">Termín</label><input n:name="dueAt" class="form-control"></div>
                    <div class="col-12"><button n:name="send" class="btn btn-primary">Přidat navazující úkol</button></div>
                </div>
            {/form}
        </details>
        <details n:if="$openActionItemCount > 0">
            <summary class="fw-semibold">Uzavřít navazující úkol</summary>
            {form actionItemStatusForm, class: 'mt-3 d-flex flex-wrap gap-2 align-items-end'}
                <div><label n:name="actionItemId" class="form-label">Otevřený úkol</label><select n:name="actionItemId" class="form-select"></select></div>
                <button n:name="complete" class="btn btn-success">Označit jako hotové</button>
                <button n:name="cancel" class="btn btn-outline-secondary">Zrušit úkol</button>
            {/form}
        </details>
    </div>
</section>

<section class="card shadow-sm mb-4" aria-labelledby="application-title">
    <div class="card-body">
        <h2 id="application-title" class="h5">Stav reakce: {$workflowLabels[$opportunity->decisionState->workflowStatus] ?? $opportunity->decisionState->workflowStatus}</h2>
        <p class="text-body-secondary">Připravený text čeká na schválení. Až po skutečném odeslání přejde nabídka do „Čekáme na odpověď“. Tento formulář pouze zaznamenává stav.</p>
        {if $opportunity->decisionState->workflowStatus !== 'closed' && ($opportunity->decisionState->decision->value === 'react' || $opportunity->decisionState->workflowStatus !== 'none')}
        <details n:attr="open => $presenter['applicationForm']->hasErrors()">
            <summary class="fw-semibold">Zaznamenat přípravu, odeslání nebo odpověď</summary>
            {form applicationForm, class: 'mt-3'}
                <div n:if="$form->hasErrors()" class="alert alert-danger"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
                <div class="row g-3">
                    <div class="col-md-6"><label n:name="event" class="form-label">Co se stalo</label><select n:name="event" class="form-select"></select></div>
                    <div class="col-md-6"><label n:name="occurredAt" class="form-label">Kdy se to stalo (Praha)</label><input n:name="occurredAt" class="form-control"></div>
                    <div class="col-12"><label n:name="reference" class="form-label">Podklad nebo potvrzení</label><textarea n:name="reference" class="form-control" rows="2"></textarea><div class="form-text">Příprava: cesta k finálnímu návrhu. Odeslání: konkrétní potvrzení portálu nebo ID ověřeného odeslaného e-mailu. Odpověď: odkaz či ID přijaté zprávy. Nezadávejte hesla ani celé zprávy.</div></div>
                </div>
                <fieldset class="border rounded p-3 my-3">
                    <legend class="float-none w-auto fs-6 px-2">Vyplňte pouze při zaznamenání odeslání</legend>
                    <div class="row g-3">
                        <div class="col-md-6"><label n:name="channel" class="form-label">Kanál odeslání</label><select n:name="channel" class="form-select"></select></div>
                        <div class="col-md-6"><label n:name="followUpAt" class="form-label">Kdy zkontrolovat odpověď (Praha)</label><input n:name="followUpAt" class="form-control"><div class="form-text">Návrh: za 7 dní. Upravte podle dohody s firmou; tento čas se přenese do Todoistu.</div></div>
                        <div class="col-12"><label n:name="approvalReference" class="form-label">Kde je výslovné schválení odeslání</label><input n:name="approvalReference" class="form-control" placeholder="Např. schválení konečné verze v tasku Práce, datum a čas"></div>
                        <div class="col-12"><label n:name="completeIds" class="form-label">Přípravné úkoly dokončené odesláním (volitelné)</label><select n:name="completeIds" class="form-select"></select><div class="form-text">Vyberte jen úkoly, které jsou opravdu hotové. Uzavřou se i v Todoistu.</div></div>
                        <div class="col-12"><label><input n:name="confirmSent" class="form-check-input"> Potvrzuji skutečné schválené odeslání s doloženým potvrzením.</label></div>
                    </div>
                </fieldset>
                <button n:name="save" class="btn btn-primary">Uložit stav reakce</button>
            {/form}
        </details>
        {elseif $opportunity->decisionState->workflowStatus === 'closed'}<p class="mb-0">Jednání je uzavřeno; historie zůstává uložená.</p>
        {else}<p class="mb-0">Pro přípravu nejprve zvolte Reagovat.</p>{/if}
        <details n:if="count($applicationHistory) > 0" class="mt-3">
            <summary>Historie reakce ({count($applicationHistory)})</summary>
            <ol class="mt-2">
                <li n:foreach="$applicationHistory as $event">
                    <strong>{$workflowLabels[$event['workflow_status']]}</strong> — {$event['details']['occurred_at']}<br>
                    {$event['details']['reference']}
                </li>
            </ol>
        </details>
    </div>
</section>

<section class="card shadow-sm mb-4 border-primary-subtle" aria-labelledby="decision-title">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="decision-title" class="h5 mb-0">Moje rozhodnutí</h2>
            <span class="badge {if $opportunity->decisionState->decision->value === 'react'}text-bg-success{elseif $opportunity->decisionState->decision->value === 'uninteresting'}text-bg-secondary{else}text-bg-light border{/if}">
                {if $opportunity->decisionState->decision->value === 'react'}Zájem: reagovat{elseif $opportunity->decisionState->decision->value === 'uninteresting'}Nezajímavé{else}Nerozhodnuto{/if}
            </span>
        </div>
        <p class="small text-body-secondary">„Reagovat“ nabídku pouze zařadí do interní fronty. Nic neodešle a nepředá žádné osobní údaje.</p>
        {form decisionForm}
            <div n:if="$form->hasErrors()" class="alert alert-danger" role="alert"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label n:name="reason" class="form-label">Důvod pro „Nezajímavé“</label>
                    <select n:name="reason" class="form-select"></select>
                </div>
                <div class="col-12 col-lg-8">
                    <label n:name="note" class="form-label">Soukromá poznámka <span class="text-body-secondary">(volitelné)</span></label>
                    <textarea n:name="note" class="form-control"></textarea>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button n:name="react" class="btn btn-success">Reagovat</button>
                    <button n:name="uninteresting" class="btn btn-outline-secondary">Nezajímavé</button>
                    <button n:if="$opportunity->decisionState->decision->value !== 'undecided'" n:name="undo" class="btn btn-link">Zpět na nerozhodnuto</button>
                </div>
            </div>
        {/form}
        <details n:if="count($decisionHistory) > 0" class="mt-4">
            <summary class="fw-semibold version-summary">Historie rozhodnutí ({count($decisionHistory)})</summary>
            <ol class="list-group list-group-numbered mt-2">
                <li n:foreach="$decisionHistory as $event" class="list-group-item d-flex justify-content-between gap-3">
                    <div>
                        <div>
                            {if $event->previousDecision->value === 'react'}K reakci{elseif $event->previousDecision->value === 'uninteresting'}Nezajímavé{else}Nerozhodnuto{/if}
                            <span aria-hidden="true">→</span>
                            <strong>{if $event->newDecision->value === 'react'}K reakci{elseif $event->newDecision->value === 'uninteresting'}Nezajímavé{else}Nerozhodnuto{/if}</strong>
                        </div>
                        <div n:if="$event->reasonLabel !== null" class="small text-body-secondary">Důvod: {$event->reasonLabel}</div>
                        <div n:if="$event->note !== null" class="small preserve-lines mt-1">{$event->note}</div>
                    </div>
                    <time class="small text-body-secondary text-nowrap" datetime="{$event->createdAt|date:'c'}">{$event->createdAt|date:'j. n. Y H:i'}</time>
                </li>
            </ol>
        </details>
    </div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="h5 mb-0">Podmínky</h2>
            <a n:href="OpportunityTerms: $opportunity->id" class="small">Upravit</a>
        </div>
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="small text-body-secondary">Sazba</div>
                <div class="fw-semibold">
                    {if $opportunity->terms?->rateMin !== null || $opportunity->terms?->rateMax !== null}
                        {$opportunity->terms?->rateMin ?? '?'}–{$opportunity->terms?->rateMax ?? '?'} {$opportunity->terms?->currency ?? ''}{if $opportunity->terms?->rateUnit !== null}/{$opportunity->terms->rateUnit}{/if}
                    {else}Neznámá{/if}
                </div>
                <div n:if="$opportunity->terms?->rateSource !== null" class="small text-body-secondary">{$opportunity->terms->rateSource}, jistota {$opportunity->terms->rateConfidence}</div>
            </div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Režim</div><div class="fw-semibold">{$opportunity->terms?->remoteMode ?? 'Neznámý'}</div></div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Práce z ČR</div><div class="fw-semibold">{if $opportunity->terms?->workFromCzechia === true}Ano{elseif $opportunity->terms?->workFromCzechia === false}Ne{else}Neověřeno{/if}</div></div>
            <div class="col-6 col-lg-3"><div class="small text-body-secondary">Rozsah</div><div class="fw-semibold">{if $opportunity->terms?->workloadMin !== null || $opportunity->terms?->workloadMax !== null}{$opportunity->terms?->workloadMin ?? '?'}–{$opportunity->terms?->workloadMax ?? '?'} {$opportunity->terms?->workloadUnit ?? ''}{else}Neznámý{/if}</div></div>
            <div n:if="$opportunity->terms?->location !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Lokalita</div><div>{$opportunity->terms->location}</div></div>
            <div n:if="$opportunity->terms?->workingLanguage !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Jazyk</div><div>{$opportunity->terms->workingLanguage}</div></div>
            <div n:if="$opportunity->terms?->communicationMode !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Komunikace</div><div>{$opportunity->terms->communicationMode}</div></div>
            <div n:if="$opportunity->terms?->durationText !== null" class="col-6 col-lg-3"><div class="small text-body-secondary">Délka</div><div>{$opportunity->terms->durationText}</div></div>
        </div>
        <div n:if="count($opportunity->technologies) > 0" class="mt-3 d-flex flex-wrap gap-2">
            <span n:foreach="$opportunity->technologies as $technology" class="badge {$technology->requirementLevel === 'required' ? 'text-bg-primary' : ($technology->requirementLevel === 'advantage' ? 'text-bg-info' : 'text-bg-light border')}">{$technology->name}{if $technology->requirementLevel === 'required'} · povinné{elseif $technology->requirementLevel === 'advantage'} · výhodou{/if}</span>
        </div>
    </div>
</section>

<section n:if="$opportunity->summary !== null" class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Shrnutí</h2>
        <p class="mb-0 preserve-lines">{$opportunity->summary}</p>
    </div>
</section>

<div class="row g-4">
    <div n:if="$opportunity->translatedText !== null" class="col-12 col-xl-6">
        <section class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Český překlad</h2>
                <p n:if="$opportunity->translatedTitle !== null" class="fw-semibold">{$opportunity->translatedTitle}</p>
                <div class="offer-text">{$opportunity->translatedText}</div>
            </div>
        </section>
    </div>
    <div class="col-12 {$opportunity->translatedText !== null ? 'col-xl-6' : ''}">
        <section class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Originál</h2>
                <p class="fw-semibold">{$opportunity->originalTitle}</p>
                <div class="offer-text">{$opportunity->originalText}</div>
            </div>
        </section>
    </div>
</div>

<p class="small text-body-secondary mt-4 mb-0">
    Nalezeno {$opportunity->foundAt|date:'j. n. Y H:i'}, aktuální verze získána {$opportunity->acquiredAt|date:'j. n. Y H:i'}{if $opportunity->sourceLanguage !== null}, jazyk {$opportunity->sourceLanguage}{/if}.
</p>

<section n:if="$opportunity->versionCount > 1" class="mt-5" aria-labelledby="version-history-title">
    <h2 id="version-history-title" class="h4 mb-3">Historie verzí</h2>
    <div class="vstack gap-2">
        <details n:foreach="$opportunity->versions as $version" class="card shadow-sm" n:attr="open => $version->current">
            <summary class="card-header version-summary">
                <span class="fw-semibold">{$version->acquiredAt|date:'j. n. Y H:i'}</span>
                <span n:if="$version->current" class="badge text-bg-primary ms-2">Aktuální</span>
                <span n:if="$version->incomplete" class="badge text-bg-warning ms-2">Neúplná</span>
            </summary>
            <div class="card-body">
                <h3 class="h6">{$version->translatedTitle ?? $version->originalTitle}</h3>
                <div n:if="$version->translatedText !== null" class="offer-text mb-4">{$version->translatedText}</div>
                <h4 n:if="$version->translatedText !== null" class="h6 text-body-secondary">Originál</h4>
                <div class="offer-text">{$version->originalText}</div>
            </div>
        </details>
    </div>
</section>
{/block}
