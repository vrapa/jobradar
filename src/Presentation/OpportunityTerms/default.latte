{block title}Podmínky nabídky{/block}

{block content}
<nav aria-label="Drobečková navigace" class="mb-3">
    <a n:href="Home:" class="text-decoration-none">Nabídky</a><span class="mx-2">/</span>
    <a n:href="Opportunity:detail $opportunity->id" class="text-decoration-none">{$opportunity->title}</a><span class="mx-2">/</span>
    <span aria-current="page">Podmínky</span>
</nav>
<header class="mb-4">
    <h1 class="display-6 fw-bold">Podmínky a technologie</h1>
    <p class="lead text-body-secondary">Neověřené údaje nechte prázdné. Známá sazba vyžaduje původ i jistotu.</p>
</header>

<div class="card shadow-sm"><div class="card-body p-3 p-md-4">
{form termsForm}
    <div n:if="$form->hasErrors()" class="alert alert-danger" role="alert"><ul class="mb-0"><li n:foreach="$form->errors as $error">{$error}</li></ul></div>
    <h2 class="h5">Sazba</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2"><label n:name="rateMin" class="form-label">Od</label><input n:name="rateMin" class="form-control"></div>
        <div class="col-6 col-lg-2"><label n:name="rateMax" class="form-label">Do</label><input n:name="rateMax" class="form-control"></div>
        <div class="col-6 col-lg-2"><label n:name="currency" class="form-label">Měna</label><input n:name="currency" class="form-control"></div>
        <div class="col-6 col-lg-2"><label n:name="rateUnit" class="form-label">Za</label><select n:name="rateUnit" class="form-select"></select></div>
        <div class="col-12 col-lg-3"><label n:name="rateSource" class="form-label">Původ údaje</label><input n:name="rateSource" class="form-control"></div>
        <div class="col-12 col-lg-1"><label n:name="rateConfidence" class="form-label">Jistota</label><input n:name="rateConfidence" class="form-control"></div>
    </div>

    <h2 class="h5">Spolupráce</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4"><label n:name="engagementMode" class="form-label">Forma spolupráce</label><input n:name="engagementMode" class="form-control"></div>
        <div class="col-6 col-md-2"><label n:name="workloadMin" class="form-label">Rozsah od</label><input n:name="workloadMin" class="form-control"></div>
        <div class="col-6 col-md-2"><label n:name="workloadMax" class="form-label">Rozsah do</label><input n:name="workloadMax" class="form-control"></div>
        <div class="col-12 col-md-4"><label n:name="workloadUnit" class="form-label">Jednotka rozsahu</label><input n:name="workloadUnit" class="form-control"></div>
        <div class="col-12 col-md-4"><label n:name="durationText" class="form-label">Délka spolupráce</label><input n:name="durationText" class="form-control"></div>
        <div class="col-6 col-md-4"><label n:name="remoteMode" class="form-label">Režim práce</label><select n:name="remoteMode" class="form-select"></select></div>
        <div class="col-6 col-md-4"><label n:name="workFromCzechia" class="form-label">Práce z ČR</label><select n:name="workFromCzechia" class="form-select"></select></div>
        <div class="col-12 col-md-4"><label n:name="location" class="form-label">Lokalita</label><input n:name="location" class="form-control"></div>
        <div class="col-12 col-md-4"><label n:name="workTimezone" class="form-label">Časové pásmo</label><input n:name="workTimezone" class="form-control"></div>
        <div class="col-12 col-md-4"><label n:name="workingLanguage" class="form-label">Pracovní jazyk</label><input n:name="workingLanguage" class="form-control"></div>
        <div class="col-12 col-md-4"><label n:name="communicationMode" class="form-label">Komunikace</label><input n:name="communicationMode" class="form-control"></div>
    </div>

    <h2 class="h5">Technologie</h2>
    <p class="small text-body-secondary">Názvy oddělujte čárkou nebo novým řádkem.</p>
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4"><label n:name="requiredTechnologies" class="form-label">Povinné</label><textarea n:name="requiredTechnologies" class="form-control"></textarea></div>
        <div class="col-12 col-lg-4"><label n:name="advantageTechnologies" class="form-label">Výhodou</label><textarea n:name="advantageTechnologies" class="form-control"></textarea></div>
        <div class="col-12 col-lg-4"><label n:name="otherTechnologies" class="form-label">Další / neurčeno</label><textarea n:name="otherTechnologies" class="form-control"></textarea></div>
    </div>
    <div class="d-flex gap-2"><button n:name="send" class="btn btn-primary">Uložit podmínky</button><a n:href="Opportunity:detail $opportunity->id" class="btn btn-outline-secondary">Zrušit</a></div>
{/form}
</div></div>
{/block}
