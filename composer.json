{
  "name": "radovan-kraus/jobradar",
  "description": "Privacy-first, self-hosted job opportunity management for humans and AI assistants",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Radovan Kraus",
      "role": "Creator and maintainer"
    }
  ],
  "keywords": [
    "job-search",
    "mcp",
    "nette",
    "privacy",
    "self-hosted"
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "latte/latte": "^3.0",
    "mcp/sdk": "^0.8.1",
    "nette/application": "^3.2",
    "nette/bootstrap": "^3.2",
    "nette/database": "^3.2",
    "nette/forms": "^3.2",
    "nette/security": "^3.2",
    "nette/utils": "^4.0",
    "symfony/console": "^7.3",
    "symfony/dotenv": "^7.3",
    "tomaj/nette-api": "^3.4",
    "tracy/tracy": "^2.10"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit",
    "check": [
      "@test",
      "@analyse"
    ]
  }
}
