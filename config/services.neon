services:
	router: App\Core\RouterFactory::createRouter
	- App\Security\DatabaseAuthenticator
	- App\Security\LoginRateLimiter
	- App\Security\PasswordPolicy
	- App\Infrastructure\AuditLogger
	migrationRunner:
		factory: App\Infrastructure\MigrationRunner
		arguments:
			migrationDirectory: %appDir%/../migrations
	- App\Console\MigrateCommand
	- App\Console\CreateAdminCommand
	- App\Console\ImportOpportunitiesCommand
	- App\Console\ImportAssessmentConfigurationCommand
	- App\Console\ImportAssessmentCommand
	- App\Console\CreateApiClientCommand
	- App\Opportunity\UrlNormalizer
	- App\Opportunity\OpportunityImportService
	- App\Opportunity\OpportunityQueryService
	- App\Opportunity\OpportunityTermsService
	- App\Opportunity\OpportunityJsonMapper
	- App\Decision\OpportunityDecisionService
	- App\Decision\DecisionQueryService
	- App\Assessment\AssessmentService
	- App\Assessment\AssessmentQueryService
	- App\Assessment\AssessmentConfigurationMapper
	- App\Assessment\AssessmentConfigurationService
	- App\Assessment\AssessmentPayloadMapper
	- App\Search\SearchRequestService
	- App\Search\SourceQueryService
	- App\Search\RunnerLeaseService
	- App\Search\SearchRunService
	- App\Search\SearchRequestControlService
	- App\Api\Auth\ApiCredentialService
	- App\Api\Auth\ApiRequestContext
	- App\Api\V1\SourcesHandler
	- Tomaj\NetteApi\Misc\IpDetector
	apiOutputConfigurator: Tomaj\NetteApi\Output\Configurator\EnvConfigurator
	apiErrorHandler: Tomaj\NetteApi\Error\DefaultErrorHandler
	apiPresenter:
		factory: Tomaj\NetteApi\Presenters\ApiPresenter
		setup:
			- setCorsHeader('off')
	sourcesApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'sources:read'
	apiDecider:
		factory: Tomaj\NetteApi\ApiDecider
		setup:
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'sources'), 'App\Api\V1\SourcesHandler', @sourcesApiAuthorization)
