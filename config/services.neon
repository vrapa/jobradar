services:
	router: App\Core\RouterFactory::createRouter
	- App\Security\DatabaseAuthenticator
	- App\Security\LoginRateLimiter
	- App\Security\PasswordPolicy
	- App\Infrastructure\AuditLogger
	migrationRunner:
		factory: App\Infrastructure\MigrationRunner
		arguments:
			migrationDirectory: %appDir%/../migrations
	- App\Console\MigrateCommand
	databaseTransfer:
		factory: App\Infrastructure\DatabaseTransferService
		arguments:
			host: %database.host%
			port: %database.port%
			databaseName: %database.name%
			user: %database.user%
			password: %database.password%
	- App\Console\BackupDatabaseCommand
	- App\Console\RestoreDatabaseCommand
	- App\Console\CreateAdminCommand
	- App\Console\ImportOpportunitiesCommand
	- App\Console\ImportAssessmentConfigurationCommand
	- App\Console\ImportAssessmentCommand
	- App\Console\CreateApiClientCommand
	- App\Runner\FakeSourceAdapter
	runnerHttpClient:
		factory: App\Runner\CurlRunnerHttpClient
	runWorkerOnceCommand:
		factory: App\Console\RunWorkerOnceCommand
	- App\Opportunity\UrlNormalizer
	- App\Opportunity\OpportunityImportService
	- App\Opportunity\ProjectCareService
	- App\Opportunity\CounterpartyService
	- App\Opportunity\OpportunityQueryService
	- App\Opportunity\OpportunityTermsService
	- App\Opportunity\OpportunityJsonMapper
	- App\Action\ActionItemService
	- App\Application\ApplicationWorkflowService
	- App\Decision\OpportunityDecisionService
	- App\Decision\DecisionQueryService
	- App\Decision\DecisionDelegationService
	- App\Assessment\AssessmentService
	- App\Assessment\AssessmentQueryService
	- App\Assessment\AssessmentConfigurationMapper
	- App\Assessment\AssessmentConfigurationService
	- App\Assessment\AssessmentPayloadMapper
	- App\Search\SearchRequestService
	- App\Search\SourceQueryService
	- App\Search\SourceSettingsService
	- App\Search\AccessPreparationService
	- App\Search\RunnerLeaseService
	- App\Search\SearchRunService
	- App\Search\SearchRequestControlService
	- App\Search\RunnerDeviceService
	- App\Search\ExecutionService
	- App\Search\SearchStepService
	- App\Api\V1\ExecutionHandler
	- App\Api\Auth\ApiCredentialService
	- App\Api\Auth\ApiRequestContext
	- App\Api\AssistantActionService
	- App\Api\V1\SourcesHandler
	- App\Api\V1\SourceTransformer
	- App\Api\V1\LoginRequiredSourcesHandler
	- App\Api\V1\SearchRequestTransformer
	- App\Api\V1\CreateSearchRequestHandler
	- App\Api\V1\GetSearchRequestHandler
	- App\Api\V1\ResumeSearchRequestHandler
	- App\Api\V1\CancelSearchRequestHandler
	- App\Api\V1\ClaimRunnerLeaseHandler
	- App\Api\V1\RenewRunnerLeaseHandler
	- App\Api\V1\RecordSourceProgressHandler
	- App\Api\V1\OpportunityTransformer
	- App\Api\V1\AssessmentTransformer
	- App\Api\V1\ListOpportunitiesHandler
	- App\Api\V1\GetOpportunityHandler
	- App\Api\V1\ImportOpportunityHandler
	- App\Api\V1\SetOpportunityDecisionHandler
	- App\Api\V1\SaveOpportunityAssessmentHandler
	- App\Api\V1\CreateDecisionDelegationHandler
	- App\Api\V1\ApplyDecisionDelegationHandler
	- App\Api\V1\ListActionItemsHandler
	- App\Api\V1\LinkExternalTaskHandler
	- App\Api\V1\CompleteActionItemHandler
	- App\Api\V1\RecordApplicationEventHandler
	- App\Api\V1\ListLinkedActionItemsHandler
	- App\Api\V1\AcknowledgeActionItemHandler
	- Tomaj\NetteApi\Misc\IpDetector
	apiOutputConfigurator: Tomaj\NetteApi\Output\Configurator\EnvConfigurator
	apiErrorHandler: Tomaj\NetteApi\Error\DefaultErrorHandler
	apiPresenter:
		factory: Tomaj\NetteApi\Presenters\ApiPresenter
		setup:
			- setCorsHeader('off')
	sourcesApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'sources:read'
	searchControlApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'search:control'
	runnerWriteApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'search:write'
	executionApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'search:execute'
	opportunitiesReadApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'opportunities:read'
	opportunitiesImportApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'opportunities:import'
	decisionsWriteApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'decisions:write'
	decisionsDelegateApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'decisions:delegate'
	assessmentsWriteApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'assessments:write'
	actionItemsReadApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'action_items:read'
	actionItemsWriteApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'action_items:write'
	applicationsWriteApiAuthorization:
		factory: App\Api\Auth\ScopedBearerAuthorization
		arguments:
			requiredScope: 'applications:write'
	apiDecider:
		factory: Tomaj\NetteApi\ApiDecider
		setup:
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'sources'), 'App\Api\V1\SourcesHandler', @sourcesApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'runner', 'execution'), 'App\Api\V1\ExecutionHandler', @executionApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'sources', 'requiring-login'), 'App\Api\V1\LoginRequiredSourcesHandler', @sourcesApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'search-requests'), 'App\Api\V1\CreateSearchRequestHandler', @searchControlApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'search-requests', 'detail'), 'App\Api\V1\GetSearchRequestHandler', @searchControlApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'search-requests', 'resume'), 'App\Api\V1\ResumeSearchRequestHandler', @searchControlApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'search-requests', 'cancel'), 'App\Api\V1\CancelSearchRequestHandler', @searchControlApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'runner', 'lease'), 'App\Api\V1\ClaimRunnerLeaseHandler', @runnerWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'runner', 'renew-lease'), 'App\Api\V1\RenewRunnerLeaseHandler', @runnerWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'search-runs', 'progress'), 'App\Api\V1\RecordSourceProgressHandler', @runnerWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'opportunities'), 'App\Api\V1\ListOpportunitiesHandler', @opportunitiesReadApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'opportunities', 'detail'), 'App\Api\V1\GetOpportunityHandler', @opportunitiesReadApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'opportunities', 'import'), 'App\Api\V1\ImportOpportunityHandler', @opportunitiesImportApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('PUT', '1', 'opportunities', 'decision'), 'App\Api\V1\SetOpportunityDecisionHandler', @decisionsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'opportunities', 'assessment'), 'App\Api\V1\SaveOpportunityAssessmentHandler', @assessmentsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'decision-delegations'), 'App\Api\V1\CreateDecisionDelegationHandler', @decisionsDelegateApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'decision-delegations', 'decisions'), 'App\Api\V1\ApplyDecisionDelegationHandler', @decisionsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'action-items'), 'App\Api\V1\ListActionItemsHandler', @actionItemsReadApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'applications', 'events'), 'App\Api\V1\RecordApplicationEventHandler', @applicationsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('GET', '1', 'action-items', 'linked'), 'App\Api\V1\ListLinkedActionItemsHandler', @actionItemsReadApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'action-items', 'synced'), 'App\Api\V1\AcknowledgeActionItemHandler', @actionItemsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'action-items', 'external-task'), 'App\Api\V1\LinkExternalTaskHandler', @actionItemsWriteApiAuthorization)
			- addApi(\Tomaj\NetteApi\EndpointIdentifier('POST', '1', 'action-items', 'complete'), 'App\Api\V1\CompleteActionItemHandler', @actionItemsWriteApiAuthorization)
